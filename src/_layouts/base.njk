<!doctype html>
<html lang="en" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  <link rel="canonical" href="{{ (canonical or page.url) | absoluteUrl }}">
  <link rel="icon" href="/favicon.ico">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:title" content="{{ title }}">
  {% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
  <meta property="og:url" content="{{ (canonical or page.url) | absoluteUrl }}">
  {% if ogImage %}<meta property="og:image" content="{{ ogImage }}">{% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <link rel="stylesheet" href="/assets/gc-motion.css">
  <link rel="stylesheet" href="/assets/site.css">
  <script type="module" src="/assets/js/gc.js"></script>
  {% if schemaJson %}
  <script type="application/ld+json">{{ schemaJson | safe }}</script>
  {% endif %}
</head>
<body{% if season %} data-season="{{ season }}"{% endif %}{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
  <a class="visually-hidden" href="#main">Skip to content</a>
  {% include "header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "footer.njk" %}
</body>
</html>
