---
permalink: /on-the-trail-of-tom-thomson/project-overview.html
layout: base.njk
section: thomson
title: "Project Overview · Gene Canning"
eleventyComputed:
  description: "Gene Canning’s account of paddling and painting Tom Thomson’s routes through Algonquin Park."
---
{% set overview = pages['/on-the-trail-of-tom-thomson/project-overview.html'] %}
<div class="wrap page-intro trailhead-story">
  <h1>Project Overview</h1>
  <span class="gc-knife" aria-hidden="true"></span>
  <div class="trailhead-overview-lead">
    {% for img in overview.images %}
      <figure class="gc-mat trailhead-overview-photo">
        {{ img.file | displayImg(img.alt or "Project Overview") | safe }}
      </figure>
    {% endfor %}
    <div class="prose">
      {% for p in overview.paragraphs %}
        {% if loop.index0 >= 1 and loop.index0 <= 4 %}
          <p>{{ p }}</p>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  <h2 class="trailhead-overview-words">In Gene’s words</h2>
  <div class="prose">
    {% for p in overview.paragraphs %}
      {% if loop.index0 >= 5 and loop.index0 < overview.paragraphs.length - 1 %}
        <p>{{ p }}</p>
      {% endif %}
    {% endfor %}
    <p class="trailhead-overview-thanks">{{ overview.paragraphs[overview.paragraphs.length - 1] }}</p>
  </div>
</div>
