---
permalink: /biography.html
layout: base.njk
section: about
title: "About Gene · Gene Canning"
description: "Biography of artist Gene Canning, painter of the natural world, based in Peterborough, Ontario."
---
{% set bio = pages['/biography.html'] %}
<div class="wrap page-intro">
  {# Nav label is "About Gene"; URL stays /biography.html (handoff: label only). #}
  <h1>About Gene</h1>
  <span class="gc-knife" aria-hidden="true"></span>
  <div class="prose" style="margin-bottom: 64px;">
    {% for img in bio.images %}
      <figure class="gc-mat narrative-figure">
        {{ img.file | displayImg(img.alt or "Gene Canning") | safe }}
      </figure>
    {% endfor %}
    {% for p in bio.paragraphs %}
      {% if p == "GENE CANNING's ACCOMPLISHMENTS:" %}
        <h2 class="bio-accomplishments">{{ p }}</h2>
      {% else %}
        <p>{{ p }}</p>
      {% endif %}
    {% endfor %}
  </div>
</div>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Gene Canning",
  "url": "{{ site.url }}",
  "jobTitle": "Painter",
  "homeLocation": { "@type": "Place", "name": "Peterborough, Ontario" },
  "email": "mailto:{{ site.email }}"
}
</script>
