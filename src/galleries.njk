---
pagination:
  data: galleries
  size: 1
  alias: gallery
permalink: "{{ gallery.path }}"
layout: base.njk
eleventyComputed:
  title: "{{ gallery.title }} · Gene Canning"
  season: "{% if gallery.series == 'spring-season-paintings' %}spring{% elif gallery.series == 'summer-season-paintings' %}summer{% elif gallery.series == 'fall-season-paintings' %}fall{% elif gallery.series == 'winter-season-paintings' %}winter{% endif %}"
---
{% set isThomson = gallery.path.indexOf('tom-thomson') >= 0 %}
{% set seasonName = season or "" %}
{% set galleryId = gallery.series or (gallery.path | slugFromPath) %}

<div class="wrap page-intro">
  <h1>{{ gallery.title }}</h1>
  <span class="gc-knife{% if seasonName %} gc-knife--lake{% endif %}" aria-hidden="true"></span>
  {% if isThomson %}
  <nav class="season-tabs" aria-label="Tom Thomson seasons">
    <a href="/on-the-trail-of-tom-thomson/spring-season-paintings/" {% if seasonName == "spring" %}aria-current="page"{% endif %}>Spring</a>
    <a href="/on-the-trail-of-tom-thomson/summer-season-paintings/" {% if seasonName == "summer" %}aria-current="page"{% endif %}>Summer</a>
    <a href="/on-the-trail-of-tom-thomson/fall-season-paintings/" {% if seasonName == "fall" %}aria-current="page"{% endif %}>Fall</a>
    <a href="/on-the-trail-of-tom-thomson/winter-season-paintings/" {% if seasonName == "winter" %}aria-current="page"{% endif %}>Winter</a>
    <a href="/on-the-trail-of-tom-thomson/studio-paintings/" {% if gallery.series == "studio-paintings" %}aria-current="page"{% endif %}>Studio</a>
    <a href="/on-the-trail-of-tom-thomson/photos-from-the-trail/" {% if gallery.series == "photos-from-the-trail" %}aria-current="page"{% endif %}>Photos</a>
    <a href="/on-the-trail-of-tom-thomson/videos-from-the-trail/" {% if gallery.series == "videos-from-the-trail" %}aria-current="page"{% endif %}>Videos</a>
  </nav>
  {% endif %}
  {% set introParas = gallery.intro %}
  {% if (not introParas or introParas.length == 0) and pages[gallery.path] %}
    {% set introParas = pages[gallery.path] | galleryIntroParas %}
  {% endif %}
  {% if introParas and introParas.length %}
  <div class="prose gallery-note gc-prose">
    {% for p in introParas %}
      <p>{{ p | linkContactUs | safe }}</p>
    {% endfor %}
  </div>
  {% endif %}
</div>

{% if gallery.series == "photos-from-the-trail" %}
  {% set items = photos %}
{% else %}
  {% set items = artworks | bySeries(gallery.series) %}
{% endif %}

<div class="wrap">
  {% if gallery.series != "photos-from-the-trail" and gallery.series != "videos-from-the-trail" %}
  <div class="gc-filter" role="group" aria-label="Show"
       data-gc-filter-for="{{ galleryId }}" data-gc-filter-key="status" hidden>
    <span class="gc-filter-label">Show:</span>
    <button type="button" data-gc-filter="all" aria-pressed="true">All</button>
    <button type="button" data-gc-filter="available" aria-pressed="false">Available</button>
    <button type="button" data-gc-filter="sold" aria-pressed="false">Sold</button>
    <button type="button" data-gc-filter="private" aria-pressed="false">Private</button>
    <button type="button" data-gc-filter="artist" aria-pressed="false">Artist</button>
  </div>
  <div class="gc-filter" role="group" aria-label="Medium"
       data-gc-filter-for="{{ galleryId }}" data-gc-filter-key="medium" hidden>
    <span class="gc-filter-label">Medium:</span>
    <button type="button" data-gc-filter="all" aria-pressed="true">All</button>
    <button type="button" data-gc-filter="oil" aria-pressed="false">Oil</button>
    <button type="button" data-gc-filter="acrylic" aria-pressed="false">Acrylic</button>
    <button type="button" data-gc-filter="graphite" aria-pressed="false">Graphite</button>
  </div>
  <p class="gc-filter-count" data-gc-filter-count-for="{{ galleryId }}" aria-live="polite"></p>
  {% endif %}

  <div id="{{ galleryId }}" class="gc-grid" data-gc-gallery>
    {% for art in items %}
      {% galleryCard art, loop.first %}
    {% endfor %}
  </div>
</div>
