<script>
  (() => {
    const params = new URLSearchParams(location.search);
    const from = params.get('from');
    const link = document.getElementById('back-link');
    if (from && from.startsWith('/') && !from.startsWith('//')) {
      link.href = from;
      link.textContent = 'Back to where you were';
    }
  })();
</script>
