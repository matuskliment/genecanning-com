---
permalink: /original-paintings/index.html
layout: base.njk
section: paintings
title: "Original Paintings · Gene Canning"
---
{% set pageData = pages['/original-paintings/index.html'] %}
<div class="wrap page-intro">
  <h1>{{ pageData.title or "Original Paintings" }}</h1>
  <div class="prose lede">
    {% for p in pageData.paragraphs %}<p>{{ p }}</p>{% endfor %}
  </div>
  <div class="teaser-grid" style="margin: 40px 0 64px;">
    {% for t in homepage.paintingTeasers %}
      {% set cover = artworks | findBySlug(t.coverSlug) %}
      {% if not cover %}
        {% set cover = (artworks | bySeries(t.href.split('/')[2]))[0] %}
      {% endif %}
      <a class="teaser-card" href="{{ t.href }}">
        <span class="gc-mat teaser-mat">
          {% if cover %}
            {{ cover.image | thumbImg(t.title, loop.first) | safe }}
          {% endif %}
        </span>
        <span class="gc-title">{{ t.title }}</span>
        <span class="meta">{{ t.meta }}</span>
      </a>
    {% endfor %}
  </div>
</div>
