---
permalink: /
layout: base.njk
section: home
eleventyComputed:
  title: "Welcome · Artist Gene Canning, Painter of the natural world"
  description: "Gene Canning. Welcome to my website. Painter of the natural world — wildlife, landscapes, and On the Trail of Tom Thomson."
  ogImage: "{{ siteImages.homeHero | ogImageUrl }}"
---
{% set home = pages['/index.html'] %}

<section class="gc-intro wrap" aria-labelledby="welcome-h">
  <div class="gc-hero"
       style="--title-x: {{ siteImages.heroTitleX }}; --title-y: {{ siteImages.heroTitleY }}; --title-size: {{ siteImages.heroTitleSize }}">
    <figure class="gc-hero-frame gc-hero-frame--home">
      {% heroPhoto siteImages.homeHero, siteImages.homeHeroAlt or siteImages.homeHeroCaption %}
    </figure>
    <h1 id="welcome-h" class="gc-hero-title">Gene Canning</h1>
  </div>

  <div class="gc-intro-row">
    <div class="gc-letter">
      {% if home.paragraphs[1] %}<p>{{ home.paragraphs[1] }}</p>{% endif %}
      {% if home.paragraphs[2] %}<p>{{ home.paragraphs[2] }}</p>{% endif %}
      {% if home.paragraphs[5] %}<p>{{ home.paragraphs[5] }}</p>{% endif %}
      {% if home.paragraphs[6] %}<p>{{ home.paragraphs[6] }}</p>{% endif %}
      <p style="font-size: 22px; font-style: italic; color: var(--gc-lake)">Enjoy the journey with me. — Gene</p>
    </div>
    <div class="gc-recognition">
      <h2>Recognition</h2>
      <span class="gc-knife" aria-hidden="true"></span>
      <ul>
        {% for item in homepage.recognition %}
          <li>{{ item }}</li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

<div class="wrap">
  <section class="home-section home-section--flip">
    <div>
      <div class="gc-photo">
        {{ siteImages.thomsonTeaser | displayImg(siteImages.thomsonTeaserAlt) | safe }}
      </div>
      <p class="caption">{{ homepage.thomsonTeaser.photoCaption }}</p>
    </div>
    <div class="home-section__text prose gc-prose">
      <p class="label">{{ homepage.thomsonTeaser.label }}</p>
      <h2>{{ homepage.thomsonTeaser.title }}</h2>
      <span class="gc-knife" aria-hidden="true"></span>
      <p>{{ homepage.thomsonTeaser.body }}</p>
      <p><a class="gc-pencil" href="/on-the-trail-of-tom-thomson/">Discover more about Tom Thomson Project</a></p>
    </div>
  </section>

  <section class="home-section home-section--teasers">
    <div>
      <h2>Original paintings</h2>
      <span class="gc-knife" aria-hidden="true"></span>
      <div class="teaser-grid">
        {% for t in homepage.paintingTeasers %}
          {% set cover = artworks | findBySlug(t.coverSlug) %}
          {% if not cover %}
            {% set cover = (artworks | bySeries(t.href.split('/')[2]))[0] %}
          {% endif %}
          <a class="teaser-card" href="{{ t.href }}">
            <span class="gc-mat teaser-mat">
              {% if cover %}
                {{ cover.image | thumbImg(t.title, loop.first) | safe }}
              {% endif %}
            </span>
            <span class="gc-title">{{ t.title }}</span>
            <span class="meta">{{ t.meta }}</span>
          </a>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="home-section">
    <div>
      {% set pbsPage = pages['/pbs-tvs-journeys-of-an.html'] %}
      {% set pbsVideo = pbsPage.videos[0] if pbsPage and pbsPage.videos and pbsPage.videos.length else null %}
      {% if pbsVideo %}
      <div class="video-wrap">
        <iframe
          src="{{ pbsVideo }}"
          title="Journeys of an Artist — promotional video"
          allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"></iframe>
      </div>
      {% else %}
      <div class="gc-photo" style="background: var(--gc-lake); min-height: 220px; display:flex; align-items:center; justify-content:center;">
        <a class="gc-btn gc-btn--light" href="{{ homepage.pbsTeaser.ctaHref }}">Watch on the PBS page</a>
      </div>
      {% endif %}
    </div>
    <div class="home-section__text prose gc-prose">
      <p class="label">{{ homepage.pbsTeaser.label }}</p>
      <h2>{{ homepage.pbsTeaser.title }}</h2>
      <span class="gc-knife" aria-hidden="true"></span>
      <p>{{ homepage.pbsTeaser.body }}</p>
      <p><a class="gc-pencil" href="{{ homepage.pbsTeaser.ctaHref }}">{{ homepage.pbsTeaser.cta }}</a></p>
    </div>
  </section>
</div>
